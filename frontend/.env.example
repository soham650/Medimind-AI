# MediMind Frontend Environment Variables
# Copy this file to .env and fill in the values for your project

# Supabase Project Credentials (safe to expose client-side)
VITE_SUPABASE_URL=https://your-supabase-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ML Microservice Backend
VITE_ML_SERVICE_URL=http://localhost:8000

# WebRTC Configuration (Public-safe STUN servers)
VITE_WEBRTC_STUN_URL=stun:stun.l.google.com:19302
