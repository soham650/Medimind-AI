# MediMind ML Microservice Configuration
SUPABASE_URL=https://your-supabase-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
PORT=8000

# Server-Side AI & Report Intelligence Configuration (Phase 2)
# NEVER commit or expose GEMINI_API_KEY to frontend code
GEMINI_API_KEY=your-gemini-api-key
GEMINI_REPORT_MODEL=gemini-3.5-flash-lite
MAX_REPORT_SIZE_MB=10
REPORT_TEMP_DIR=
REPORT_ANALYSIS_TIMEOUT_SECONDS=25
REPORT_RATE_LIMIT=15
